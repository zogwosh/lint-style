{
  "name": "lintstyle",
  "version": "0.1.0",
  "description": "Opinionated ESLint flat config: hand-written layers (base / typescript / typed / stylistic / imports / node / browser) plus custom lintstyle rules",
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "typescript",
    "lint"
  ],
  "type": "module",
  "files": [
    "configs",
    "index.ts",
    "index.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run typecheck && npm run lint"
  },
  "peerDependencies": {
    "eslint": ">=9.20.0"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^6.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^16.0.0",
    "jiti": "^2.4.0",
    "typescript-eslint": "^8.72.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "typescript": "^5.7.0"
  }
}
